# =============================================================================
# SIGAP backend: contoh environment variable
# =============================================================================
# Salin menjadi `.env` lalu isi. Jangan commit `.env`.
#
# Format komentar: [WAJIB|OPSIONAL] [RAHASIA] deskripsi. Default: … Contoh: …
#
# Aturan penting:
# - Variabel OPSIONAL sengaja ditulis sebagai baris ter-comment. Untuk mengubah
#   default, hapus tanda `#` lalu isi nilainya. JANGAN dibiarkan kosong
#   (`NAMA=`): startup akan gagal dengan pesan "tidak boleh kosong".
# - Startup gagal (fail-fast) bila variabel wajib kosong atau formatnya salah;
#   pesan error hanya menyebut nama variabel, tidak pernah nilainya.
# - Membuat nilai rahasia:
#     openssl rand -hex 32          # JWT_SECRET, CRON_SECRET, DEVICE_SHARED_KEY
#     npx web-push generate-vapid-keys   # VAPID_PUBLIC_KEY & VAPID_PRIVATE_KEY
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# [OPSIONAL] Mode runtime. `production` mengaktifkan aturan wajib tambahan
# (VAPID_*, DEVICE_SHARED_KEY, JWT_ISSUER, JWT_AUDIENCE, ALLOWED_ORIGINS) dan
# menolak origin localhost di CORS. Default: (tidak di-set = development). Contoh: production
# NODE_ENV=production

# [OPSIONAL] Port HTTP backend. Default: 3000. Contoh: 3000
# PORT=3000

# [OPSIONAL] Format log akses HTTP (format morgan: combined | common | short | tiny | dev,
# atau format token kustom). Log tidak memuat header Authorization/x-cron-secret/x-device-token.
# Default: combined bila NODE_ENV=production, selain itu dev. Contoh: combined
# LOG_FORMAT=combined

# [OPSIONAL] Batas waktu graceful shutdown (ms) setelah SIGTERM/SIGINT sebelum
# proses dipaksa keluar. Default: 10000. Contoh: 10000
# SHUTDOWN_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# [WAJIB] [RAHASIA] Connection string PostgreSQL. Bila memuat `sslmode=...`,
# parameter itu MENIMPA DB_SSL (perilaku driver pg). Jika password mengandung
# karakter khusus, lakukan URL-encoding.
# Default: -. Contoh: postgresql://sigap:<password>@db:5432/sigap
DATABASE_URL=

# [OPSIONAL] Mode SSL koneksi DB: disable | require | verify-full.
# Tidak di-set = host localhost/127.0.0.1 tanpa SSL, host lain `require`.
# Default: (heuristik di atas). Contoh: disable (container Postgres di jaringan internal Docker)
# DB_SSL=disable

# [OPSIONAL] Jumlah koneksi maksimum di pool DB (>= 1). Default: 5. Contoh: 5
# DB_POOL_MAX=5

# [OPSIONAL] Koneksi idle ditutup setelah sekian ms (0 = tidak pernah). Default: 10000. Contoh: 10000
# DB_POOL_IDLE_MS=10000

# -----------------------------------------------------------------------------
# Keamanan & autentikasi
# -----------------------------------------------------------------------------

# [WAJIB] [RAHASIA] Secret penandatangan JWT admin, minimal 32 karakter.
# Default: -. Contoh: (hasil `openssl rand -hex 32`)
JWT_SECRET=

# [OPSIONAL] Masa berlaku token JWT (format jsonwebtoken). Default: 1d. Contoh: 8h
# JWT_EXPIRES_IN=1d

# [OPSIONAL, WAJIB bila NODE_ENV=production] Claim `iss` JWT. Default: sigap-backend. Contoh: sigap-backend
# JWT_ISSUER=sigap-backend

# [OPSIONAL, WAJIB bila NODE_ENV=production] Claim `aud` JWT. Default: sigap-admin-dashboard. Contoh: sigap-admin-dashboard
# JWT_AUDIENCE=sigap-admin-dashboard

# [WAJIB] [RAHASIA] Secret pemicu manual scheduler (header `x-cron-secret` atau
# `Authorization: Bearer`) untuk POST /api/public/internal/run-scheduler.
# Default: -. Contoh: (hasil `openssl rand -hex 32`)
CRON_SECRET=

# [OPSIONAL, WAJIB bila NODE_ENV=production] [RAHASIA] Shared key perangkat IoT
# (header `x-device-token`). Default: -. Contoh: (hasil `openssl rand -hex 32`)
# DEVICE_SHARED_KEY=

# [OPSIONAL, WAJIB bila NODE_ENV=production di luar Vercel] Origin yang diizinkan
# CORS, dipisah koma. Origin aplikasi sendiri WAJIB dicantumkan: browser tetap
# mengirim header Origin pada request tulis (login, CRUD admin) meskipun same-origin.
# Default: -. Contoh: https://sigap.example.com,https://www.sigap.example.com
# ALLOWED_ORIGINS=

# [OPSIONAL] Proxy yang dipercaya untuk menentukan IP klien (req.ip, dipakai
# rate limiter & lastLoginIp). Isi jumlah hop (mis. 1) atau daftar subnet/preset
# dipisah koma. `true` DITOLAK (X-Forwarded-For bisa dipalsukan).
# Tidak di-set = 1 di Vercel, selain itu tidak ada proxy yang dipercaya.
# Default: (tidak di-set). Contoh: loopback, linklocal, uniquelocal (disarankan
# di belakang reverse proxy ber-IP privat, mis. jaringan Docker)
# TRUST_PROXY=loopback, linklocal, uniquelocal

# -----------------------------------------------------------------------------
# Web push (notifikasi warga)
# -----------------------------------------------------------------------------

# [OPSIONAL, WAJIB bila NODE_ENV=production] VAPID public key. Default: -. Contoh: (hasil `npx web-push generate-vapid-keys`)
# VAPID_PUBLIC_KEY=

# [OPSIONAL, WAJIB bila NODE_ENV=production] [RAHASIA] VAPID private key. Default: -. Contoh: (hasil `npx web-push generate-vapid-keys`)
# VAPID_PRIVATE_KEY=

# [OPSIONAL, WAJIB bila NODE_ENV=production] Kontak VAPID (mailto: atau https:).
# Default: mailto:admin@sigap.desa.id. Contoh: mailto:admin@sigap.desa.id
# VAPID_SUBJECT=mailto:admin@sigap.desa.id

# -----------------------------------------------------------------------------
# Scheduler peringatan dini (BMKG)
# -----------------------------------------------------------------------------

# [OPSIONAL] Jalankan scheduler di dalam proses backend. Harus `true` di server
# yang berjalan terus (mis. container); hanya boleh aktif di SATU replika.
# Default: (nonaktif). Contoh: true
# ENABLE_LOCAL_SCHEDULER=true

# [OPSIONAL] Interval siklus scheduler (ms), minimum 15000. Default: 60000. Contoh: 60000
# ALERT_SCHEDULER_INTERVAL_MS=60000

# [OPSIONAL] [RAHASIA] URL heartbeat (mis. healthchecks.io / Uptime Kuma push
# monitor) yang di-GET setelah setiap siklus sukses. Tidak pernah ditulis ke log.
# Default: -. Contoh: https://hc-ping.com/<uuid>
# SCHEDULER_HEARTBEAT_URL=

# [OPSIONAL] Override manual status tsunami: AWAS | SIAGA | WASPADA | NORMAL.
# Hanya untuk uji/latihan; jangan di-set di operasional normal.
# Default: (estimasi otomatis dari data gempa BMKG). Contoh: NORMAL
# BMKG_TSUNAMI_STATUS=

# -----------------------------------------------------------------------------
# Lokasi desa & data BMKG
# -----------------------------------------------------------------------------

# [OPSIONAL] Koordinat desa (derajat desimal). Default: -7.6838 / 108.5610. Contoh: -7.6838
# VILLAGE_LAT=-7.6838
# VILLAGE_LON=108.5610

# [OPSIONAL] Kode wilayah adm4 BMKG untuk prakiraan cuaca. Default: 32.18.01.2008. Contoh: 32.18.01.2008
# BMKG_ADM4_CODE=32.18.01.2008

# [OPSIONAL] TTL cache data gempa (ms). Default: 30000. Contoh: 30000
# EARTHQUAKE_CACHE_TTL_MS=30000

# [OPSIONAL] Radius gempa relevan Pangandaran (km, bilangan bulat). Default: 100. Contoh: 100
# PANGANDARAN_RADIUS_KM=100

# [OPSIONAL] Radius gempa relevan Jawa Barat (km, bilangan bulat). Default: 350. Contoh: 350
# WEST_JAVA_RADIUS_KM=350

# [OPSIONAL] Umur maksimum gempa relevan Pangandaran (hari). Default: 7. Contoh: 7
# PANGANDARAN_MAX_AGE_DAYS=7

# [OPSIONAL] Umur maksimum gempa relevan Jawa Barat (hari). Default: 7. Contoh: 7
# WEST_JAVA_MAX_AGE_DAYS=7

# -----------------------------------------------------------------------------
# HTTP keluar (BMKG, Open-Meteo)
# -----------------------------------------------------------------------------

# [OPSIONAL] Timeout per request keluar (ms). Default: 8000. Contoh: 8000
# HTTP_TIMEOUT_MS=8000

# [OPSIONAL] Jumlah retry request keluar. Default: 2. Contoh: 2
# HTTP_RETRY_COUNT=2

# [OPSIONAL] Jeda awal antar retry (ms). Default: 500. Contoh: 500
# HTTP_RETRY_DELAY_MS=500
