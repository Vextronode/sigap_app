# =============================================================================
# SIGAP: variabel DB untuk mode DB "external" (server PostgreSQL di luar compose)
# =============================================================================
# Salin menjadi sigap.external.env (chmod 600). Dipakai oleh: sigap.sh up --db external.
# File ini dimuat SETELAH sigap.env dan hanya menimpa variabel DB di bawah; variabel
# aplikasi tetap dari sigap.env. Tidak ada container db/POSTGRES_* pada mode ini.
# Semua <...> WAJIB diganti; sigap.sh menolak jalan bila masih ada placeholder.

# [WAJIB] [RAHASIA] Connection string runtime backend (boleh lewat pooler).
# TANPA `sslmode` di URL: pakai DB_SSL (sslmode di URL menimpa DB_SSL).
# Contoh: postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# [WAJIB] [RAHASIA] Connection string LANGSUNG (bukan pooler) khusus migrasi
# (`sigap.sh migrate`). Boleh sama dengan DATABASE_URL bila tidak memakai pooler.
DIRECT_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_DIRECT_HOST>:5432/<DB_NAME>

# [WAJIB] Mode SSL: require | verify-full (disable hanya untuk jaringan privat tepercaya).
DB_SSL=verify-full
