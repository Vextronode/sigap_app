# =============================================================================
# SIGAP: env runtime container backend, migrate, dan db (mode DB "local")
# =============================================================================
# Salin menjadi sigap.env (chmod 600). Jangan commit.
# Format komentar: [WAJIB|OPSIONAL] [RAHASIA] deskripsi. Default: … Contoh: …
#
# Aturan:
# - Semua <...> WAJIB diganti; deploy/sigap.sh menolak jalan bila masih ada placeholder.
# - Nilai tanpa tanda kutip dan tanpa spasi.
# - Variabel OPSIONAL ditulis ter-comment. Untuk mengubah default, hapus `#` lalu
#   isi. JANGAN dibiarkan kosong (`NAMA=`): backend menolak start ("tidak boleh kosong").
# - Membuat nilai rahasia:
#     openssl rand -hex 32                # JWT_SECRET, CRON_SECRET, DEVICE_SHARED_KEY
#     openssl rand -hex 24                # POSTGRES_PASSWORD (alfanumerik, aman di URL)
#     npx web-push generate-vapid-keys    # VAPID_PUBLIC_KEY & VAPID_PRIVATE_KEY
# - Mode DB "external" (server PostgreSQL di luar compose): tetap isi file ini
#   untuk variabel aplikasi; variabel DB ditimpa oleh sigap.external.env.
# - Daftar variabel backend di file ini harus sama dengan apps/backend/.env.example
#   (dicek di CI).
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# [WAJIB] Mode runtime. Image backend sudah men-set production; dicantumkan agar eksplisit.
NODE_ENV=production

# [OPSIONAL] Port HTTP backend di dalam container. Default: 3000. Contoh: 3000
# PORT=3000

# [OPSIONAL] Format log akses HTTP (morgan). Default: combined (production). Contoh: combined
# LOG_FORMAT=combined

# [OPSIONAL] Batas waktu graceful shutdown (ms). Harus < stop_grace_period compose (15 s).
# Default: 10000. Contoh: 10000
# SHUTDOWN_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Database (container `db`)
# -----------------------------------------------------------------------------

# Inisialisasi container postgres. HARUS sama dengan user/password/nama DB di
# DATABASE_URL (sigap.sh memeriksanya). Hanya berlaku saat volume pgdata pertama
# kali dibuat; mengubahnya kemudian tidak mengganti password di DB yang sudah ada.
# [WAJIB] Nama database. Contoh: sigap
POSTGRES_DB=sigap
# [WAJIB] User database. Contoh: sigap
POSTGRES_USER=sigap
# [WAJIB] [RAHASIA] Password database, alfanumerik (hasil `openssl rand -hex 24`).
POSTGRES_PASSWORD=<DB_PASSWORD>

# [WAJIB] [RAHASIA] Connection string ke service `db`, TANPA `sslmode` (sslmode di
# URL menimpa DB_SSL). Contoh: postgresql://sigap:<DB_PASSWORD>@db:5432/sigap
DATABASE_URL=postgresql://sigap:<DB_PASSWORD>@db:5432/sigap

# [WAJIB] [RAHASIA] Koneksi untuk Prisma CLI (migrasi). prisma.config.ts membaca
# DIRECT_URL lebih dulu dan gagal bila variabel ini tidak ada. Mode local: SAMA
# PERSIS dengan DATABASE_URL (sigap.sh memeriksanya).
DIRECT_URL=postgresql://sigap:<DB_PASSWORD>@db:5432/sigap

# [WAJIB] Mode SSL koneksi DB: disable | require | verify-full. Jaringan internal
# Docker tanpa SSL: disable.
DB_SSL=disable

# [OPSIONAL] Jumlah koneksi maksimum di pool DB (>= 1). Default: 5. Contoh: 5
# DB_POOL_MAX=5

# [OPSIONAL] Koneksi idle ditutup setelah sekian ms (0 = tidak pernah). Default: 10000. Contoh: 10000
# DB_POOL_IDLE_MS=10000

# -----------------------------------------------------------------------------
# Keamanan & autentikasi
# -----------------------------------------------------------------------------

# [WAJIB] [RAHASIA] Secret penandatangan JWT admin, minimal 32 karakter.
# Dibuat SEKALI; menggantinya membuat semua sesi admin tidak valid.
JWT_SECRET=<JWT_SECRET>

# [OPSIONAL] Masa berlaku token JWT (format jsonwebtoken). Default: 1d. Contoh: 8h
# JWT_EXPIRES_IN=1d

# [WAJIB] Claim `iss` JWT. Contoh: sigap-backend
JWT_ISSUER=sigap-backend

# [WAJIB] Claim `aud` JWT. Contoh: sigap-admin-dashboard
JWT_AUDIENCE=sigap-admin-dashboard

# [WAJIB] [RAHASIA] Secret pemicu manual scheduler (header `x-cron-secret`).
CRON_SECRET=<CRON_SECRET>

# [WAJIB] [RAHASIA] Shared key perangkat IoT (header `x-device-token`).
DEVICE_SHARED_KEY=<DEVICE_SHARED_KEY>

# [WAJIB] Origin aplikasi (https, tanpa garis miring akhir), dipisah koma bila lebih
# dari satu. Wajib: browser mengirim Origin pada login/CRUD admin meski same-origin.
# Contoh: https://sigap.example.org
ALLOWED_ORIGINS=https://<HOSTNAME_PUBLIK>

# [WAJIB] Proxy yang dipercaya untuk IP klien (rate limit, lastLoginIp). Preset ini
# melewati semua hop ber-IP privat (Caddy di container web, proxy internal).
# `true` DITOLAK. Bila ada proxy ber-IP publik di depan (selain edge yang menulis
# X-Forwarded-For), beri tahu tim SIGAP.
TRUST_PROXY=loopback,linklocal,uniquelocal

# -----------------------------------------------------------------------------
# Web push (notifikasi warga)
# -----------------------------------------------------------------------------

# [WAJIB] VAPID public key (hasil `npx web-push generate-vapid-keys`).
VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>

# [WAJIB] [RAHASIA] VAPID private key.
VAPID_PRIVATE_KEY=<VAPID_PRIVATE_KEY>

# [WAJIB] Kontak VAPID (mailto: atau https:). Contoh: mailto:admin@sigap.desa.id
VAPID_SUBJECT=mailto:<EMAIL_ADMIN>

# -----------------------------------------------------------------------------
# Scheduler peringatan dini (BMKG)
# -----------------------------------------------------------------------------

# [WAJIB] Scheduler berjalan di dalam proses backend. Hanya SATU replika backend.
ENABLE_LOCAL_SCHEDULER=true

# [OPSIONAL] Interval siklus scheduler (ms), minimum 15000. Default: 60000. Contoh: 60000
# ALERT_SCHEDULER_INTERVAL_MS=60000

# [OPSIONAL] [RAHASIA] URL heartbeat (healthchecks.io / Uptime Kuma push) yang di-GET
# setelah siklus sukses. Tidak pernah ditulis ke log. Contoh: https://hc-ping.com/<uuid>
# SCHEDULER_HEARTBEAT_URL=

# [OPSIONAL] Override manual status tsunami: AWAS | SIAGA | WASPADA | NORMAL.
# Hanya untuk uji/latihan; jangan di-set di operasional normal.
# BMKG_TSUNAMI_STATUS=

# -----------------------------------------------------------------------------
# Lokasi desa & data BMKG
# -----------------------------------------------------------------------------

# [OPSIONAL] Koordinat desa (derajat desimal). Default: -7.6838 / 108.5610.
# VILLAGE_LAT=-7.6838
# VILLAGE_LON=108.5610

# [OPSIONAL] Kode wilayah adm4 BMKG untuk prakiraan cuaca. Default: 32.18.01.2008.
# BMKG_ADM4_CODE=32.18.01.2008

# [OPSIONAL] TTL cache data gempa (ms). Default: 30000.
# EARTHQUAKE_CACHE_TTL_MS=30000

# [OPSIONAL] Radius gempa relevan Pangandaran (km). Default: 100.
# PANGANDARAN_RADIUS_KM=100

# [OPSIONAL] Radius gempa relevan Jawa Barat (km). Default: 350.
# WEST_JAVA_RADIUS_KM=350

# [OPSIONAL] Umur maksimum gempa relevan Pangandaran (hari). Default: 7.
# PANGANDARAN_MAX_AGE_DAYS=7

# [OPSIONAL] Umur maksimum gempa relevan Jawa Barat (hari). Default: 7.
# WEST_JAVA_MAX_AGE_DAYS=7

# -----------------------------------------------------------------------------
# HTTP keluar (BMKG, Open-Meteo)
# -----------------------------------------------------------------------------

# [OPSIONAL] Timeout per request keluar (ms). Default: 8000.
# HTTP_TIMEOUT_MS=8000

# [OPSIONAL] Jumlah retry request keluar. Default: 2.
# HTTP_RETRY_COUNT=2

# [OPSIONAL] Jeda awal antar retry (ms). Default: 500.
# HTTP_RETRY_DELAY_MS=500
