# Salin menjadi compose.env (chmod 600). Dibaca docker compose lewat --env-file
# oleh deploy/sigap.sh; hanya untuk interpolasi compose.reference.yml.
# SIGAP_DB_ENV_FILE dan COMPOSE_PROFILES SENGAJA tidak diisi di sini: sigap.sh
# menentukannya dari mode DB (.state/db_mode):
#   local    -> sigap.env + profil localdb (container Postgres)
#   external -> sigap.env + sigap.external.env (menimpa variabel DB)
# Semua <...> WAJIB diganti; sigap.sh menolak jalan bila masih ada placeholder.

# [WAJIB] Nama proyek compose (awalan container/volume, mis. sigap-backend-1, sigap_pgdata).
SIGAP_PROJECT=sigap

# [WAJIB] Tag image yang di-build dan dijalankan. Jangan pernah "latest".
# Contoh: v1.0.0-staging
SIGAP_IMAGE_TAG=<vX.Y.Z>

# [WAJIB] Alamat & port host untuk container web (SPA + /api).
# 127.0.0.1 = hanya bisa diakses dari host itu sendiri (reverse proxy/TLS
# pengelola di host yang sama). Bila proxy di mesin lain, isi IP privat host.
# Default: 127.0.0.1 / 8080.
SIGAP_HTTP_BIND=127.0.0.1
SIGAP_HTTP_PORT=8080
