@startuml uc_kesiapsiagaan_iot
left to right direction
title SIGAP - Use Case: Kesiapsiagaan dan Perangkat

actor "Warga Desa" as Warga
actor "Unit Utama" as UU
actor "Google Maps" as GM

rectangle "Sistem SIGAP" {
  usecase "Lihat Info Kesiapsiagaan" as UC1
  usecase "Buka Navigasi Titik Evakuasi" as UC2
  usecase "Berlangganan Notifikasi" as UC3
  usecase "Terima Notifikasi Level Alert" as UC4
  usecase "Evaluasi Aturan Alert" as UC5
  usecase "Registrasi Perangkat" as UC6
  usecase "Baca Level" as UC7
  usecase "Kirim Heartbeat" as UC8
}

Warga --> UC1
Warga --> UC2
Warga --> UC3
Warga --> UC4

UC2 --> GM
UC5 .> UC4 : <<include>>

UU --> UC6
UU --> UC7
UU --> UC8

@enduml
