@startuml uc_overview
left to right direction
skinparam packageStyle rectangle
title SIGAP - Use Case Overview

actor "Warga Desa" as Warga
actor "Admin" as Admin
actor "Operator" as Operator
actor "Sumber Eksternal\n(BMKG/USGS/OWM/AI)" as Ext
actor "Unit Utama" as UU
actor "Sirine/Toa" as Si

rectangle "Sistem SIGAP" {
  package "Monitoring Lingkungan" {
    usecase "Lihat Dashboard Lingkungan" as UC1
    usecase "Lihat Ringkasan AI" as UC2
  }

  package "Kesiapsiagaan & IoT" {
    usecase "Lihat Info Kesiapsiagaan" as UC3
    usecase "Terima Notifikasi Level Alert" as UC4
    usecase "Verifikasi Level & Putuskan Tindakan" as UC8
    usecase "Trigger Sirine" as UC9
  }

  package "Administrasi Konten (Tahap 1+2)" {
    usecase "Kelola Kontak Darurat" as UC6
    usecase "Kelola Titik & Jalur Evakuasi" as UC7
    usecase "Kelola Panduan Kesiapsiagaan" as UC7b
    usecase "Klasifikasi Alert" as UC8b
  }

  package "Manajemen Perangkat & Keselamatan (Tahap 2, baru)" {
    usecase "Manajemen Perangkat IoT" as UC12
    usecase "Riwayat Status & Aktivasi Sirine" as UC13
  }

  package "Manajemen Pengguna & Sistem (Tahap 2, baru)" {
    usecase "Manajemen Akun & Role" as UC15
    usecase "Lihat Dashboard Admin" as UC16
  }
}

Warga --> UC1
Warga --> UC2
Warga --> UC3
Warga --> UC4

Admin --> UC6
Admin --> UC7
Admin --> UC7b
Admin --> UC8b
Admin --> UC8
Admin --> UC9
Admin --> UC12
Admin --> UC13
Admin --> UC15
Admin --> UC16

Operator --> UC6
Operator --> UC7
Operator --> UC7b
Operator --> UC8b
Operator --> UC8
Operator --> UC9
Operator --> UC12
Operator --> UC13
Operator --> UC16

Ext --> UC1
Ext --> UC2
UU --> UC4
UC9 --> Si

note bottom of UC9
  Detail relasi (include/extend) tidak
  digambarkan di file overview ini.
  Lihat uc_kesiapsiagaan_iot.puml.
end note

note bottom of UC15
  Khusus Admin - satu-satunya
  pembeda fungsional Admin vs
  Operator di seluruh sistem.
end note

@enduml