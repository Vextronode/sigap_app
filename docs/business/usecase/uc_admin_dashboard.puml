@startuml uc_admin_dashboard
left to right direction
title SIGAP - Use Case: Administrasi Konten dan Sistem

actor "Admin" as Admin
actor "Operator" as Operator

rectangle "Sistem SIGAP" {
  usecase "Login" as UC0
  usecase "Kelola Kontak Darurat" as UC1
  usecase "Kelola Titik Evakuasi" as UC2
  usecase "Kelola Panduan Kesiapsiagaan" as UC3
  usecase "Klasifikasi Alert" as UC4
  usecase "Lihat Dashboard Admin" as UC5
  usecase "Pantau Kesehatan Sistem" as UC6
  usecase "Ganti Password Sendiri" as UC7
  usecase "Manajemen Akun dan Role" as UC8
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8

Operator --> UC1
Operator --> UC2
Operator --> UC3
Operator --> UC4
Operator --> UC5
Operator --> UC6
Operator --> UC7

UC1 .> UC0 : <<include>>
UC2 .> UC0 : <<include>>
UC3 .> UC0 : <<include>>
UC4 .> UC0 : <<include>>
UC5 .> UC0 : <<include>>
UC6 .> UC0 : <<include>>
UC7 .> UC0 : <<include>>
UC8 .> UC0 : <<include>>

@enduml
